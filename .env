# FuelFlow Africa - Environment Configuration
# Copy this file to .env and update values

# Application Settings
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
API_VERSION=v1

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# MongoDB Database
MONGODB_URI=mongodb://localhost:27017/fuelflow_africa
MONGODB_URI_TEST=mongodb://localhost:27017/fuelflow_test

# Redis
REDIS_URL=redis://localhost:6379

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Provider
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@fuelflow.africa

# Nomba Payment API
NOMBA_BASE_URL=https://api.nomba.dev
NOMBA_PUBLIC_KEY=706df6c4-b8bb-4130-88c4-d21b052f8631
NOMBA_SECRET_KEY= k8UobYk3APgOoxUnNL7VpuxzwTsH4LsXtydfjcHs8RH0YISBB4OMqJsaafG+U8fWETu9YZ96bNXE+DelCDuMPw==
NOMBA_INTEGRATION_ID=your-nomba-integration-id
NOMBA_INTEGRATION_SECRET=your-nomba-integration-secret

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-signature-secret-here
WEBHOOK_URL=http://localhost:5000/api/v1/webhooks/nomba

# Payment Settings
PAYMENT_RETRY_ATTEMPTS=3
PAYMENT_RETRY_DELAY_1_HOURS=24
PAYMENT_RETRY_DELAY_2_HOURS=72
CARD_EXPIRY_NOTIFICATION_DAYS=30

# CORS
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Pagination
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Fuel Prices (NGN)
PETROL_PRICE_PER_LITER=1175
DIESEL_PRICE_PER_LITER=1150
LPG_PRICE_PER_KG=2000

# Subscription Plans (NGN)
PLAN_WEEKLY_AMOUNT=15000
PLAN_BIWEEKLY_AMOUNT=28000
PLAN_MONTHLY_AMOUNT=55000
PLAN_QUARTERLY_AMOUNT=150000
